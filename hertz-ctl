out_lock = threading.Lock()


def emit(obj):
    # ASCII escapes: no string (e.g. a lone surrogate from a stream title) can
    # make the write fail.
    line = json.dumps(obj, separators=(",", ":"), ensure_ascii=True)
    with out_lock:
        try:
            sys.stdout.write(line + "\n")
            sys.stdout.flush()
        except (BrokenPipeError, ValueError):
            os._exit(0)


def log(*parts):
    print("hertz-ctl:", *parts, file=sys.stderr, flush=True)


def write_json(path, data):
    """Atomic write through a fresh, exclusively created temp file."""
    folder = os.path.dirname(path)
    os.makedirs(folder, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".tmp-", suffix=".json")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def read_json(path, fallback):
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, type(fallback)) else fallback
    except (OSError, ValueError):
        return fallback


# ------------------------------------------------------------------ network guard
#
# Station records (logo and stream URLs) come from a public, community-edited
# directory, so they are untrusted. Every request this helper makes goes
# through `fetch()`, which only ever connects to public internet addresses:
#
#   * the host is resolved here and *every* address must be globally routable
#     (no loopback, private, link-local, CGNAT, multicast, reserved, or
#     IPv4-mapped forms of those); the socket then connects to exactly the
#     address that was checked, so DNS rebinding cannot swap in a local one;
#   * each redirect hop goes through the same check (at most 3, http/https);
#   * logos may only use ports 80 and 443;
#   * no proxy, FTP or file handlers are installed.

class BlockedAddress(OSError):
    """Raised instead of connecting to a non-public address."""


NAT64 = ipaddress.ip_network("64:ff9b::/96")
IPV4_COMPATIBLE = ipaddress.ip_network("::/96")
MAX_ENDPOINTS = 16


def _public(ip):
    return ip.is_global and not (ip.is_multicast or ip.is_unspecified or ip.is_reserved
                                 or getattr(ip, "is_site_local", False))


def public_ip(address):
    """True only for globally routable unicast addresses. IPv6 forms that
    carry an IPv4 address (mapped, 6to4, Teredo, NAT64, IPv4-compatible)
    must carry a public one."""
    try:
        ip = ipaddress.ip_address(str(address).split("%", 1)[0])
    except ValueError:
        return False
    if ip.version == 6:
        # IPv4-mapped (::ffff:a.b.c.d) would be routed and connected as IPv4
        # behind the IPv6 route check's back, and IPv4-compatible (::a.b.c.d)
        # is obsolete: refuse both outright.
        if ip.ipv4_mapped or ip in IPV4_COMPATIBLE:
            return False
        if ip in NAT64:                  # 64:ff9b::/96 on IPv6-only networks
            return _public(ipaddress.IPv4Address(int(ip) & 0xFFFFFFFF))
        embedded = []
        if ip.sixtofour:
            embedded.append(ip.sixtofour)
        if ip.teredo:
            embedded.extend(ip.teredo)
        if any(not _public(v4) for v4 in embedded):
            return False
    return _public(ip)


_route_cache = {}
_route_lock = threading.Lock()


def _ip_json(*args):
    out = subprocess.run(["ip", "-j", *args], capture_output=True, stdin=subprocess.DEVNULL,
                         timeout=2, check=False)
    data = json.loads(out.stdout) if out.returncode == 0 and out.stdout.strip() else []
    return data if isinstance(data, list) else []


def _cached(key, compute):
    now = time.monotonic()
    with _route_lock:
        hit = _route_cache.get(key)
        if hit and now - hit[1] < 60:
            return hit[0]
    value = compute()
    with _route_lock:
        if len(_route_cache) > 512:
            _route_cache.clear()
        _route_cache[key] = (value, now)
    return value


def _default_devices(family):
    """{device: has_gateway} for every default route (multipath included)."""
    def compute():
        devices = {}
        for r in _ip_json(family, "route", "show", "default"):
            if not isinstance(r, dict):
                continue
            for hop in r.get("nexthops") if isinstance(r.get("nexthops"), list) else [r]:
                if isinstance(hop, dict) and hop.get("dev"):
                    devices[hop["dev"]] = devices.get(hop["dev"], False) or bool(hop.get("gateway"))
        return devices
    return _cached(("default", family), compute)


def routes_to_this_machine(address):
    """True unless the kernel would send `address` out through a gateway on an
    interface that carries a default route. That refuses this machine's own
    addresses, anything directly on the LAN (including LAN devices with
    public IPv6 addresses) and specific routes into VPNs or other networks.
    Fails closed if routing can't be read."""
    def compute():
        try:
            family = "-6" if ":" in address else "-4"
            routes = _ip_json(family, "route", "get", address)
            defaults = _default_devices(family)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return True
        if not routes or not defaults:
            return True
        for r in routes:
            if not isinstance(r, dict) or r.get("type") in ("local", "broadcast", "multicast") \
                    or r.get("dev") == "lo" or r.get("dev") not in defaults:
                return True
            # Through a gateway, or through a point-to-point default route
            # (full-tunnel VPN, PPP) whose default itself has no gateway.
            if not r.get("gateway") and defaults[r.get("dev")]:
                return True
        return False
    return _cached(("route", address), compute)


# Total request deadlines. A socket timeout only bounds each read, so a server
# that trickles one byte per timeout could hold a request (and a download
# worker) forever. `Deadline` bounds the whole request: name lookup, connect,
# every redirect hop, headers and body. When it expires, a watchdog shuts down
# every socket the request opened, which also unblocks a read waiting inside
# TLS, and whatever arrived is discarded.

_active_deadline = threading.local()


class Deadline:
    def __init__(self, seconds):
        self.seconds = seconds
        self.expires = time.monotonic() + seconds
        self.expired = False
        self.sockets = []
        self.lock = threading.Lock()
        self.timer = threading.Timer(seconds, self.expire)
        self.timer.daemon = True

    def remaining(self):
        return self.expires - time.monotonic()

    def check(self):
        if self.expired or self.remaining() <= 0:
            self.expired = True
            raise TimeoutError(f"request exceeded {self.seconds:g} s")

    def track(self, sock):
        with self.lock:
            self.sockets.append(sock)
            expired = self.expired
        if expired:
            self._shut(sock)

    def expire(self):
        with self.lock:
            self.expired = True
            sockets = list(self.sockets)
        for sock in sockets:
            self._shut(sock)

    @staticmethod
    def _shut(sock):
        try:
            sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass

    def __enter__(self):
        self.previous = getattr(_active_deadline, "current", None)
        _active_deadline.current = self
        self.timer.start()
        return self

    def __exit__(self, *exc):
        self.timer.cancel()
        _active_deadline.current = self.previous
        return False


def current_deadline():
    return getattr(_active_deadline, "current", None)


def bounded_read(opener, request, limit, seconds):
    """Open `request` and read at most `limit` + 1 bytes, all within `seconds`.
    Raises TimeoutError if the whole exchange takes longer."""
    with Deadline(seconds) as deadline:
        with opener.open(request, timeout=min(8, seconds)) as resp:
            body = bytearray()
            while len(body) <= limit:
                deadline.check()
                chunk = resp.read(min(65536, limit + 1 - len(body)))
                if not chunk:
                    break
                body += chunk
        deadline.check()   # a watchdog shutdown can look like a clean EOF
        return bytes(body)


def _getaddrinfo(host, port):
    deadline = current_deadline()
    if deadline is None:
        return socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
    # The system resolver has no per-call timeout; run it aside and stop
    # waiting when the request's deadline is reached.
    result = {}

    def lookup():
        try:
            result["infos"] = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
        except BaseException as e:  # handed back to the caller below
            result["error"] = e
    worker = threading.Thread(target=lookup, daemon=True)
    worker.start()
    worker.join(max(0.0, deadline.remaining()))
    if worker.is_alive():
        deadline.check()
        raise TimeoutError(f"looking up {host} took too long")
    if "error" in result:
        raise result["error"]
    return result["infos"]


def resolve_public(host, port):
    """All addresses for host:port, or BlockedAddress if any is non-public."""
    try:
        infos = _getaddrinfo(host, port)
    except (socket.gaierror, UnicodeError) as e:
        raise OSError(f"cannot resolve {host}") from e
    if not infos or len(infos) > MAX_ENDPOINTS:
        raise BlockedAddress(f"{host} did not resolve to a usable address")
    deadline = current_deadline()
    for info in infos:
        if deadline is not None:
            deadline.check()
        address = info[4][0].split("%", 1)[0]
        if not public_ip(address) or routes_to_this_machine(address):
            raise BlockedAddress(f"{host} is not a public internet address")
    return infos


# Ports browsers refuse for HTTP (WHATWG Fetch "bad ports"), so a station
# can't make the player speak HTTP to mail, SSH, DNS or similar services.
BAD_PORTS = frozenset([0, 1, 7, 9, 11, 13, 15, 17, 19, 20, 21, 22, 23, 25, 37, 42, 43, 53,
                       69, 77, 79, 87, 95, 101, 102, 103, 104, 109, 110, 111, 113, 115, 117,
                       119, 123, 135, 137, 139, 143, 161, 179, 389, 427, 465, 512, 513, 514,
                       515, 526, 530, 531, 532, 540, 548, 554, 556, 563, 587, 601, 636, 989,
                       990, 993, 995, 1719, 1720, 1723, 2049, 3659, 4045, 4190, 5060, 5061,
                       6000, 6566, 6665, 6666, 6667, 6668, 6669, 6679, 6697, 10080])


def public_connection(ports):
    def create_connection(address, timeout=socket._GLOBAL_DEFAULT_TIMEOUT, source_address=None, **_):
        host, port = address[0], int(address[1])
        if (ports and port not in ports) or port in BAD_PORTS or not 0 < port < 65536:
            raise BlockedAddress(f"port {port} is not allowed")
        last = None
        for family, kind, proto, _name, sockaddr in resolve_public(host, port):
            sock = socket.socket(family, kind, proto)
            deadline = current_deadline()
            try:
                if deadline is not None:
                    deadline.check()
                    deadline.track(sock)        # the watchdog can shut it down
                    limit = deadline.remaining()
                    timeout = limit if timeout is socket._GLOBAL_DEFAULT_TIMEOUT else min(timeout, limit)
                if timeout is not socket._GLOBAL_DEFAULT_TIMEOUT:
                    sock.settimeout(max(0.01, timeout))
                sock.connect(sockaddr)          # the address we just vetted
                return sock
            except OSError as e:
                sock.close()
                last = e
        raise last or OSError(f"cannot connect to {host}")
    return create_connection


def guarded_opener(ports=None, https_only=False):
    class GuardedHTTP(http.client.HTTPConnection):
        def __init__(self, *args, **kwargs):
            super().__init__(*args, **kwargs)
            self._create_connection = public_connection(ports)

    class GuardedHTTPS(http.client.HTTPSConnection):
        def __init__(self, *args, **kwargs):
            super().__init__(*args, **kwargs)
            self._create_connection = public_connection(ports)

    class HTTPHandler(urllib.request.HTTPHandler):
        def http_open(self, req):
            return self.do_open(GuardedHTTP, req)

    class HTTPSHandler(urllib.request.HTTPSHandler):
        def https_open(self, req):
            return self.do_open(GuardedHTTPS, req, context=self._context)

    class Redirects(urllib.request.HTTPRedirectHandler):
        max_redirections = 3

        def redirect_request(self, req, fp, code, msg, headers, newurl):
            if urllib.parse.urlsplit(newurl).scheme not in (("https",) if https_only else ("http", "https")):
                raise BlockedAddress("redirect to a non-HTTP address")
            return super().redirect_request(req, fp, code, msg, headers, newurl)

    opener = urllib.request.OpenerDirector()
    for handler in (urllib.request.UnknownHandler(), urllib.request.HTTPDefaultErrorHandler(),
                    Redirects(), urllib.request.HTTPErrorProcessor(), HTTPSHandler(),
                    *(() if https_only else (HTTPHandler(),))):
        opener.add_handler(handler)
    return opener


API_OPENER = guarded_opener(https_only=True)  # Radio Browser mirrors: HTTPS, redirects too
ART_OPENER = guarded_opener(ports=(80, 443))  # station logos: untrusted URLs


def public_stream(url):
    """True if a stream URL's host resolves only to public addresses."""
    try:
        u = urllib.parse.urlsplit(url)
        resolve_public(u.hostname, u.port or (443 if u.scheme == "https" else 80))
        return True
    except (OSError, ValueError):
        return False


# ------------------------------------------------------------------ player sandbox
#
# mpv resolves names, follows redirects and expands playlists / HLS segment
# lists on its own, so checking a stream URL up front is not enough. The
# player therefore runs in a bubblewrap sandbox with its own, empty network
# namespace. Its only way out is this proxy (outside the sandbox, on a Unix
# socket in the private runtime dir), which applies the same public-address
# policy to every request: each redirect, playlist entry and segment arrives
# here as a new request. Direct TCP/UDP/RTSP or DNS from inside has no route.

PROXY_MAX_HEADER = 65536
PROXY_MAX_CONNECTIONS = 32
PROXY_IDLE_TIMEOUT = 90


class ProxyRefused(Exception):
    def __init__(self, status):
        super().__init__(status)
        self.status = status


def _read_header(conn):
    data = bytearray()
    while b"\r\n\r\n" not in data:
        chunk = conn.recv(16384)
        if not chunk:
            raise ProxyRefused(b"400 Bad Request")
        data.extend(chunk)
        if len(data) > PROXY_MAX_HEADER:
            raise ProxyRefused(b"431 Request Header Fields Too Large")
    end = data.index(b"\r\n\r\n") + 4
    return bytes(data[:end]), bytes(data[end:])


def _parse_proxy_request(header):
    lines = header[:-4].split(b"\r\n")
    try:
        method, target, version = lines[0].decode("ascii").split(" ")
    except (UnicodeDecodeError, ValueError):
        raise ProxyRefused(b"400 Bad Request")
    if version not in ("HTTP/1.0", "HTTP/1.1"):
        raise ProxyRefused(b"400 Bad Request")
    kept = []
    for line in lines[1:]:
        if not line or line[:1].isspace() or b":" not in line:
            raise ProxyRefused(b"400 Bad Request")
        name = line.split(b":", 1)[0].strip().lower()
        if name not in (b"host", b"connection", b"proxy-connection", b"proxy-authorization", b"keep-alive"):
            kept.append(line)
    if method == "CONNECT":
        u = urllib.parse.urlsplit("//" + target)
        try:
            port = u.port or 443
        except ValueError:
            raise ProxyRefused(b"400 Bad Request")
        if not u.hostname or u.username is not None or u.path or u.query:
            raise ProxyRefused(b"400 Bad Request")
        return method, u.hostname, port, b""
    if method not in ("GET", "HEAD"):
        raise ProxyRefused(b"405 Method Not Allowed")
    u = urllib.parse.urlsplit(target)
    try:
        port = u.port or 80
    except ValueError:
        raise ProxyRefused(b"400 Bad Request")
    if u.scheme.lower() != "http" or not u.hostname or u.username is not None or u.password is not None:
        raise ProxyRefused(b"400 Bad Request")
    path = (u.path or "/") + (f"?{u.query}" if u.query else "")
    try:
        head = [f"{method} {path} {version}".encode("ascii"), *kept,
                b"Host: " + u.netloc.encode("ascii"), b"Connection: close", b"", b""]
    except UnicodeEncodeError:
        raise ProxyRefused(b"400 Bad Request")
    return method, u.hostname, port, b"\r\n".join(head)


def _relay(a, b):
    a.settimeout(None)
    b.settimeout(None)
    while True:
        ready, _, _ = select.select((a, b), (), (), PROXY_IDLE_TIMEOUT)
        if not ready:
            return
        for src in ready:
            data = src.recv(65536)
            if not data:
                return
            (b if src is a else a).sendall(data)


class _ProxyHandler(socketserver.BaseRequestHandler):
    def handle(self):
        client = self.request
        client.settimeout(15)
        try:
            header, pending = _read_header(client)
            method, host, port, forward = _parse_proxy_request(header)
            try:
                # Lookup + connect within one deadline; the stream itself then
                # runs as long as the player wants it (idle limit in _relay).
                with Deadline(15):
                    upstream = public_connection(None)((host, port), timeout=15)
            except BlockedAddress:
                raise ProxyRefused(b"403 Forbidden")
            except OSError:
                raise ProxyRefused(b"502 Bad Gateway")
            with upstream:
                if method == "CONNECT":
                    client.sendall(b"HTTP/1.1 200 Connection Established\r\n\r\n")
                else:
                    upstream.sendall(forward)
                if pending:
                    upstream.sendall(pending)
                _relay(client, upstream)
        except ProxyRefused as e:
            try:
                client.sendall(b"HTTP/1.1 " + e.status + b"\r\nConnection: close\r\n\r\n")
            except OSError:
                pass
        except OSError:
            pass


class _LimitedServer:
    daemon_threads = True
    request_queue_size = PROXY_MAX_CONNECTIONS

    def __init__(self, *args, **kwargs):
        self._slots = threading.BoundedSemaphore(PROXY_MAX_CONNECTIONS)
        super().__init__(*args, **kwargs)

    def process_request(self, request, client_address):
        if not self._slots.acquire(blocking=False):
            self.shutdown_request(request)
            return
        try:
            super().process_request(request, client_address)
        except Exception:
            self._slots.release()
            raise

    def process_request_thread(self, request, client_address):
        try:
            super().process_request_thread(request, client_address)
        finally:
            self._slots.release()


class GuardedProxy(_LimitedServer, socketserver.ThreadingUnixStreamServer):
    """HTTP (absolute-form GET/HEAD) and HTTPS (CONNECT) proxy that only
    reaches public internet addresses."""

    def __init__(self, path):
        super().__init__(path, _ProxyHandler)


class _BridgeHandler(socketserver.BaseRequestHandler):
    def handle(self):
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as up:
                up.connect(self.server.proxy_path)
                _relay(self.request, up)
        except OSError:
            pass


class _Bridge(_LimitedServer, socketserver.ThreadingTCPServer):
    """Inside the sandbox: 127.0.0.1:<port> -> the proxy's Unix socket."""
    allow_reuse_address = True

    def __init__(self, proxy_path):
        self.proxy_path = proxy_path
        super().__init__(("127.0.0.1", 0), _BridgeHandler)


# ---- the sandbox itself (used for the player and for decoding logos)
#
# bubblewrap builds an empty mount namespace: /usr read-only, the host's
# /bin, /lib symlinks, and only the loader/TLS files needed from /etc. There
# is no /home, a private empty /tmp and /run, an empty environment, new
# user/pid/net/ipc/uts/cgroup namespaces (bubblewrap brings up loopback), no
# nested user namespaces, no capabilities, and a seccomp filter. Nothing from
# the user's session is reachable: no D-Bus, Wayland, X11, PipeWire, agents,
# Docker or systemd sockets, no personal files.

SANDBOX_ETC = ("/etc/ld.so.cache", "/etc/ssl", "/etc/ca-certificates", "/etc/pkcs11",
               "/etc/gnutls", "/etc/localtime", "/etc/fonts")
SANDBOX_PROXY = "/run/hertz-proxy.sock"    # the proxy socket inside the sandbox
SANDBOX_SCRIPT = "/opt/hertz-radio/hertz-ctl"
SANDBOX_IPC_FD = 200                       # mpv's control connection (same number inside)

# x86_64 syscalls refused inside the sandbox (EPERM); clone3 answers ENOSYS so
# libc falls back to clone. socket()/socketpair() are limited to Unix, IPv4 and
# IPv6 (no vsock, RDS, AF_ALG, netlink, packet...), personality() to its
# default and query values. Any other architecture/ABI (i386 via int 0x80,
# x32) is killed, so the list can't be sidestepped.
_SECCOMP_DENY = (101, 103, 134, 153, 154, 155, 161, 163, 165, 166, 167, 168, 169, 170,
                 171, 172, 173, 175, 176, 179, 212, 246, 248, 249, 250, 272, 298, 300,
                 303, 304, 308, 310, 311, 312, 313, 320, 321, 323, 425, 426, 427, 428,
                 429, 430, 431, 432, 433, 442)
_SECCOMP_ENOSYS = (435,)
_NR_SOCKET, _NR_SOCKETPAIR, _NR_PERSONALITY = 41, 53, 135
_ALLOWED_FAMILIES = (socket.AF_UNIX, socket.AF_INET, socket.AF_INET6)


def seccomp_program():
    """Classic-BPF seccomp filter for bwrap --seccomp, or None off x86_64."""
    if os.uname().machine != "x86_64":
        return None
    AUDIT_ARCH_X86_64 = 0xC000003E
    LD, JEQ, JGE, RET = 0x20, 0x15, 0x35, 0x06
    ALLOW, KILL, ERRNO = 0x7FFF0000, 0x80000000, 0x00050000
    ARG0 = 16                                  # low 32 bits of args[0] (little endian)
    prog, labels = [], {}

    def op(code, k=0, jt=0, jf=0):
        prog.append([code, jt, jf, k])

    def label(name):
        labels[name] = len(prog)

    op(LD, 4)                                  # A = arch
    op(JEQ, AUDIT_ARCH_X86_64, 1, 0)
    op(RET, KILL)
    op(LD, 0)                                  # A = syscall number
    op(JGE, 0x40000000, 0, 1)                  # x32 ABI
    op(RET, KILL)
    op(JEQ, _NR_SOCKET, "socket", 0)
    op(JEQ, _NR_SOCKETPAIR, "socket", 0)
    op(JEQ, _NR_PERSONALITY, "personality", 0)
    for nr in _SECCOMP_DENY:
        op(JEQ, nr, 0, 1)
        op(RET, ERRNO | errno.EPERM)
    for nr in _SECCOMP_ENOSYS:
        op(JEQ, nr, 0, 1)
        op(RET, ERRNO | errno.ENOSYS)
    op(RET, ALLOW)
    label("socket")
    op(LD, ARG0)
    for family in _ALLOWED_FAMILIES:
        op(JEQ, family, "allow", 0)
    op(RET, ERRNO | errno.EAFNOSUPPORT)
    label("personality")
    op(LD, ARG0)
    op(JEQ, 0, "allow", 0)
    op(JEQ, 0xFFFFFFFF, "allow", 0)
    op(RET, ERRNO | errno.EPERM)
    label("allow")
    op(RET, ALLOW)
    for i, ins in enumerate(prog):             # resolve relative jump targets
        for slot in (1, 2):
            if isinstance(ins[slot], str):
                offset = labels[ins[slot]] - (i + 1)
                assert 0 <= offset <= 255, "seccomp jump out of range"
                ins[slot] = offset
    return b"".join(struct.pack("=HBBI", *ins) for ins in prog)


def _memfd(name, data):
    fd = os.memfd_create(name, 0)
    os.write(fd, data)
    os.lseek(fd, 0, os.SEEK_SET)
    return fd


def sandbox_command(extra_binds=(), extra_env=(), with_script=False):
    """bwrap argument list (without the command) and the fds it needs."""
    bwrap = shutil.which("bwrap")
    if not bwrap:
        raise OSError("bubblewrap (bwrap) is required")
    cmd = [bwrap, "--unshare-all", "--unshare-user", "--disable-userns", "--cap-drop", "ALL",
           "--die-with-parent", "--new-session", "--clearenv", "--hostname", "hertz",
           "--setenv", "PATH", "/usr/bin", "--setenv", "HOME", "/tmp",
           "--setenv", "LANG", "C.UTF-8",
           "--ro-bind", "/usr", "/usr",
           "--dev", "/dev", "--remount-ro", "/dev",
           "--proc", "/proc", "--ro-bind", "/dev/null", "/proc/cmdline",
           "--size", str(SANDBOX_TMP_SIZE), "--tmpfs", "/tmp",
           "--size", str(1 << 20), "--tmpfs", "/run",
           "--dir", "/etc"]
    for link in ("/bin", "/sbin", "/lib", "/lib64"):
        if os.path.islink(link):
            cmd += ["--symlink", os.readlink(link), link]
    for path in SANDBOX_ETC:
        cmd += ["--ro-bind-try", path, path]
    fds = []
    if with_script:
        # Copied in (not bind-mounted), so no host path shows inside.
        with open(os.path.realpath(__file__), "rb") as f:
            fd = _memfd("hertz-ctl", f.read())
        fds.append(fd)
        cmd += ["--dir", os.path.dirname(SANDBOX_SCRIPT), "--perms", "0555", "--file", str(fd), SANDBOX_SCRIPT]
    for mode, src, dst in extra_binds:
        cmd += [mode, src, dst]
    for name, value in extra_env:
        cmd += ["--setenv", name, value]
    # The sandbox root is bubblewrap's own (unsized) tmpfs: make it read-only
    # once everything is in place. /tmp and /run stay writable, size-limited.
    cmd += ["--remount-ro", "/"]
    program = seccomp_program()
    if program is not None:
        fd = _memfd("hertz-seccomp", program)
        cmd += ["--seccomp", str(fd)]
        fds.append(fd)
    return cmd, fds


