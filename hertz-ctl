def public_stream(url):
    """True if a stream URL's host resolves only to public addresses."""
    try:
        u = urllib.parse.urlsplit(url)
        resolve_public(u.hostname, u.port or (443 if u.scheme == "https" else 80))
        return True
    except (OSError, ValueError):
        return False


# ------------------------------------------------------------------ player sandbox
#
# mpv resolves names, follows redirects and expands playlists / HLS segment
# lists on its own, so checking a stream URL up front is not enough. The
# player therefore runs in a bubblewrap sandbox with its own, empty network
# namespace. Its only way out is this proxy (outside the sandbox, on a Unix
# socket in the private runtime dir), which applies the same public-address
# policy to every request: each redirect, playlist entry and segment arrives
# here as a new request. Direct TCP/UDP/RTSP or DNS from inside has no route.

PROXY_MAX_HEADER = 65536
PROXY_MAX_CONNECTIONS = 32
PROXY_IDLE_TIMEOUT = 90


class ProxyRefused(Exception):
    def __init__(self, status):
        super().__init__(status)
        self.status = status


def _read_header(conn):
    data = bytearray()
    while b"\r\n\r\n" not in data:
        chunk = conn.recv(16384)
        if not chunk:
            raise ProxyRefused(b"400 Bad Request")
        data.extend(chunk)
        if len(data) > PROXY_MAX_HEADER:
            raise ProxyRefused(b"431 Request Header Fields Too Large")
    end = data.index(b"\r\n\r\n") + 4
    return bytes(data[:end]), bytes(data[end:])


def _parse_proxy_request(header):
    lines = header[:-4].split(b"\r\n")
    try:
        method, target, version = lines[0].decode("ascii").split(" ")
    except (UnicodeDecodeError, ValueError):
        raise ProxyRefused(b"400 Bad Request")
    if version not in ("HTTP/1.0", "HTTP/1.1"):
        raise ProxyRefused(b"400 Bad Request")
    kept = []
    for line in lines[1:]:
        if not line or line[:1].isspace() or b":" not in line:
            raise ProxyRefused(b"400 Bad Request")
        name = line.split(b":", 1)[0].strip().lower()
        if name not in (b"host", b"connection", b"proxy-connection", b"proxy-authorization", b"keep-alive"):
            kept.append(line)
    if method == "CONNECT":
        u = urllib.parse.urlsplit("//" + target)
        try:
            port = u.port or 443
        except ValueError:
            raise ProxyRefused(b"400 Bad Request")
        if not u.hostname or u.username is not None or u.path or u.query:
            raise ProxyRefused(b"400 Bad Request")
        return method, u.hostname, port, b""
    if method not in ("GET", "HEAD"):
        raise ProxyRefused(b"405 Method Not Allowed")
    u = urllib.parse.urlsplit(target)
    try:
        port = u.port or 80
    except ValueError:
        raise ProxyRefused(b"400 Bad Request")
    if u.scheme.lower() != "http" or not u.hostname or u.username is not None or u.password is not None:
        raise ProxyRefused(b"400 Bad Request")
    path = (u.path or "/") + (f"?{u.query}" if u.query else "")
    try:
        head = [f"{method} {path} {version}".encode("ascii"), *kept,
                b"Host: " + u.netloc.encode("ascii"), b"Connection: close", b"", b""]
    except UnicodeEncodeError:
        raise ProxyRefused(b"400 Bad Request")
    return method, u.hostname, port, b"\r\n".join(head)


def _relay(a, b):
    a.settimeout(None)
    b.settimeout(None)
    while True:
        ready, _, _ = select.select((a, b), (), (), PROXY_IDLE_TIMEOUT)
        if not ready:
            return
        for src in ready:
            data = src.recv(65536)
            if not data:
                return
            (b if src is a else a).sendall(data)


class _ProxyHandler(socketserver.BaseRequestHandler):
    def handle(self):
        client = self.request
        client.settimeout(15)
        try:
            header, pending = _read_header(client)
            method, host, port, forward = _parse_proxy_request(header)
            try:
                # Lookup + connect within one deadline; the stream itself then
                # runs as long as the player wants it (idle limit in _relay).
                with Deadline(15):
                    upstream = public_connection(None)((host, port), timeout=15)
            except BlockedAddress:
                raise ProxyRefused(b"403 Forbidden")
            except OSError:
                raise ProxyRefused(b"502 Bad Gateway")
            with upstream:
                if method == "CONNECT":
                    client.sendall(b"HTTP/1.1 200 Connection Established\r\n\r\n")
                else:
                    upstream.sendall(forward)
                if pending:
                    upstream.sendall(pending)
                _relay(client, upstream)
        except ProxyRefused as e:
            try:
                client.sendall(b"HTTP/1.1 " + e.status + b"\r\nConnection: close\r\n\r\n")
            except OSError:
                pass
        except OSError:
            pass


class _LimitedServer:
    daemon_threads = True
    request_queue_size = PROXY_MAX_CONNECTIONS

    def __init__(self, *args, **kwargs):
        self._slots = threading.BoundedSemaphore(PROXY_MAX_CONNECTIONS)
        super().__init__(*args, **kwargs)

    def process_request(self, request, client_address):
        if not self._slots.acquire(blocking=False):
            self.shutdown_request(request)
            return
        try:
            super().process_request(request, client_address)
        except Exception:
            self._slots.release()
            raise

    def process_request_thread(self, request, client_address):
        try:
            super().process_request_thread(request, client_address)
        finally:
            self._slots.release()


class GuardedProxy(_LimitedServer, socketserver.ThreadingUnixStreamServer):
    """HTTP (absolute-form GET/HEAD) and HTTPS (CONNECT) proxy that only
    reaches public internet addresses."""

    def __init__(self, path):
        super().__init__(path, _ProxyHandler)


class _BridgeHandler(socketserver.BaseRequestHandler):
    def handle(self):
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as up:
                up.connect(self.server.proxy_path)
                _relay(self.request, up)
        except OSError:
            pass


class _Bridge(_LimitedServer, socketserver.ThreadingTCPServer):
    """Inside the sandbox: 127.0.0.1:<port> -> the proxy's Unix socket."""
    allow_reuse_address = True

    def __init__(self, proxy_path):
        self.proxy_path = proxy_path
        super().__init__(("127.0.0.1", 0), _BridgeHandler)


def mpv_arguments(volume):
    return ["mpv", "--idle=yes", "--no-video", "--no-terminal", "--really-quiet",
            f"--input-ipc-server={SOCKET}", f"--volume={volume}", "--volume-max=100",
            "--cache=yes", "--cache-secs=20", "--demuxer-max-bytes=8MiB",
            "--network-timeout=12", "--user-agent=" + USER_AGENT,
            "--title=Hertz Radio", "--audio-client-name=hertz-radio",
            "--ytdl=no", "--load-unsafe-playlists=no", "--tls-verify=yes",
            "--stream-lavf-o=reconnect=1,reconnect_streamed=1,reconnect_delay_max=5"]


def run_player(volume):
    """`hertz-ctl player`: guarded proxy + sandboxed mpv, for as long as mpv runs."""
    os.umask(0o077)
    private_dir(RUNTIME)
    bwrap = shutil.which("bwrap")
    if not bwrap:
        log("player: bubblewrap (bwrap) is required to sandbox playback")
        return 3
    proxy_path = os.path.join(RUNTIME, "proxy.sock")
    if os.path.lexists(proxy_path):
        if not stat.S_ISSOCK(os.lstat(proxy_path).st_mode):
            log("player: proxy path exists and is not a socket")
            return 3
        os.unlink(proxy_path)
    proxy = GuardedProxy(proxy_path)
    threading.Thread(target=proxy.serve_forever, daemon=True).start()
    # bubblewrap: read-only filesystem except the private runtime dir, a
    # minimal /dev, own PID namespace, dies with this session. The network
    # namespace is set up by `sandbox-net` below.
    cmd = [bwrap, "--unshare-pid", "--die-with-parent", "--new-session",
           "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc",
           "--bind", RUNTIME, RUNTIME,
           "--", sys.executable, os.path.realpath(__file__), "sandbox-net", proxy_path, "--",
           *mpv_arguments(volume)]
    try:
        return subprocess.run(cmd, stdin=subprocess.DEVNULL).returncode
    finally:
        proxy.shutdown()
        proxy.server_close()
        try:
            os.unlink(proxy_path)
        except OSError:
            pass


def run_sandbox_net(proxy_path, mpv_cmd):
    """`hertz-ctl sandbox-net`: enter a new user + network namespace that holds
    only a loopback interface, then re-exec as `sandbox`. The re-exec runs as
    the normal (non-root) user, so the kernel clears every capability."""
    uid, gid = os.getuid(), os.getgid()
    os.unshare(os.CLONE_NEWUSER | os.CLONE_NEWNET)
    with open("/proc/self/setgroups", "w") as f:
        f.write("deny")
    with open("/proc/self/uid_map", "w") as f:
        f.write(f"{uid} {uid} 1")
    with open("/proc/self/gid_map", "w") as f:
        f.write(f"{gid} {gid} 1")
    siocgifflags, siocsifflags, iff_up = 0x8913, 0x8914, 0x1
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        ifr = struct.pack("16sh14x", b"lo", 0)
        flags = struct.unpack("16sh14x", fcntl.ioctl(s, siocgifflags, ifr))[1]
        fcntl.ioctl(s, siocsifflags, struct.pack("16sh14x", b"lo", flags | iff_up))
    script = os.path.realpath(__file__)
    os.execv(sys.executable, [sys.executable, script, "sandbox", proxy_path, "--", *mpv_cmd])


def sandbox_is_sealed():
    """Refuse to run the player unless it has no capabilities and no route out."""
    with open("/proc/self/status") as f:
        caps = {k: v.strip() for k, v in (line.split(":", 1) for line in f if line.startswith("Cap"))}
    if any(int(caps.get(k, "0"), 16) for k in ("CapEff", "CapPrm", "CapAmb")):
        return False
    for family, address in ((socket.AF_INET, ("1.1.1.1", 443)), (socket.AF_INET6, ("2606:4700:4700::1111", 443))):
        try:
            with socket.socket(family, socket.SOCK_STREAM) as s:
                s.settimeout(1)
                s.connect(address)
            return False
        except OSError as e:
            if e.errno not in (errno.ENETUNREACH, errno.EHOSTUNREACH, errno.EADDRNOTAVAIL, errno.EAFNOSUPPORT):
                return False
    return True


def run_sandbox(proxy_path, mpv_cmd):
    """`hertz-ctl sandbox` (inside the namespaces): start the bridge, run mpv through it."""
    if not sandbox_is_sealed():
        log("sandbox: isolation check failed; refusing to start the player")
        return 4
    bridge = _Bridge(proxy_path)
    threading.Thread(target=bridge.serve_forever, daemon=True).start()
    proxy_url = f"http://127.0.0.1:{bridge.server_address[1]}"
    env = dict(os.environ, http_proxy=proxy_url, https_proxy=proxy_url,
               HTTP_PROXY=proxy_url, HTTPS_PROXY=proxy_url, no_proxy="", NO_PROXY="")
    return subprocess.run([*mpv_cmd, f"--http-proxy={proxy_url}"], env=env,
                          stdin=subprocess.DEVNULL).returncode


def private_dir(path):
    """Create (if needed) and return a directory only this user can use.
    Refuses symlinks and directories owned by someone else."""
    os.makedirs(path, mode=0o700, exist_ok=True)
    st = os.lstat(path)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        raise PermissionError(f"{path} is not a private directory")
    if stat.S_IMODE(st.st_mode) != 0o700:
        os.chmod(path, 0o700)
    return path


def http_url(value):
    try:
        u = urllib.parse.urlsplit(value or "")
    except ValueError:
        return False
    return u.scheme in ("http", "https") and bool(u.hostname)


def valid_country(value):
    return isinstance(value, str) and len(value) == 2 and value.isascii() and value.isalpha() and value.isupper()


