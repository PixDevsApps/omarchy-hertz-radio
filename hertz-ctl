class Daemon:
    def __init__(self):
        self.directory = Directory()
        self.art = Artwork()
        self.mpv = Mpv(self.on_mpv)
        self.jobs = queue.Queue()
        self.generation = 0
        self.gen_lock = threading.Lock()

        saved = read_json(STATE_FILE, {})
        self.favorites = [s for s in saved.get("favorites", []) if isinstance(s, dict) and s.get("uuid")]
        self.volume = max(0, min(100, int(saved.get("volume", 70))))
        self.last_genre = str(saved.get("genre") or "All")
        self.last_country = saved.get("country") if valid_country(saved.get("country")) else ""
        self.station = saved.get("last") if isinstance(saved.get("last"), dict) else None

        self.results = []       # current directory page(s) shown in the panel
        self.queue = []         # list the playing station was picked from
        self.muted = False
        # "off": no player, no network | "playing" | "paused": stream dropped
        # (or, briefly after an MPRIS pause, held) with the station kept.
        self.mode = "off"
        self.pause_timer = None
        self.idle = True
        self.loaded = False     # a stream is open in mpv (and using the network)
        self.buffering = False
        self.title = ""
        self.codec = ""
        self.samplerate = 0
        self.error = ""
        self.clicked = None     # uuid already reported to Radio Browser
        self.list_cache = read_json(LIST_CACHE, {})

        self.genres = read_json(os.path.join(HERE, "genres.json"), {"All": []})
        threading.Thread(target=self.worker, daemon=True).start()

    # ---- persistence

    def save(self):
        write_json(STATE_FILE, {"favorites": self.favorites, "volume": self.volume,
                                "genre": self.last_genre, "country": self.last_country,
                                "last": self.station})

    def save_session(self):
        write_json(SESSION_FILE, {"station": self.station, "queue": self.queue,
                                  "mode": self.mode})

    # ---- output

    def publish(self):
        s = self.station
        emit({
            "type": "state",
            "station": s,
            "playing": bool(s) and self.mode == "playing",
            "paused": bool(s) and self.mode == "paused",
            "buffering": self.mode == "playing" and (self.buffering or self.idle),
            "title": self.title,
            "codec": self.codec,
            "samplerate": self.samplerate,
            "volume": self.volume,
            "muted": self.muted,
            "favorite": bool(s) and any(f["uuid"] == s["uuid"] for f in self.favorites),
            "error": self.error,
            "hasNext": len(self.queue) > 1,
        })

    def publish_favorites(self):
        emit({"type": "favorites", "items": self.favorites})
        self.art.request(self.favorites)

    # ---- mpv events

    def on_mpv(self, msg):
        ev = msg.get("event")
        if ev == "property-change":
            name, data = msg.get("name"), msg.get("data")
            if name == "pause":
                if data and self.mode == "playing":
                    # Paused from outside (media keys): hold briefly, then disconnect.
                    self.mode = "paused"
                    self.schedule(DISCONNECT_AFTER, self.disconnect_if_paused)
                    self.save_session()
                elif not data and self.mode == "paused" and self.loaded:
                    self.mode = "playing"          # resumed within the grace period
                    self.cancel_timer()
                    self.save_session()
            elif name == "core-idle":
                self.idle = bool(data)
                if not self.idle and self.mode == "playing":
                    self.error = ""
                    self.report_click()
            elif name == "path":
                self.loaded = bool(data)
            elif name == "paused-for-cache":
                self.buffering = bool(data)
            elif name == "volume" and data is not None:
                self.volume = max(0, min(100, int(round(data))))
            elif name == "mute":
                self.muted = bool(data)
            elif name == "metadata":
                self.title = icy_title(data or {})
            elif name == "audio-codec-name":
                self.codec = str(data or "").upper()
            elif name == "audio-params/samplerate":
                self.samplerate = int(data or 0)
            self.publish()
        elif ev == "end-file":
            reason = msg.get("reason")
            if reason in ("error", "eof") and self.mode == "playing":
                self.mode = "off"
                self.error = friendly_error(msg.get("file_error") or reason)
                self.save_session()
                self.publish()
        elif ev == "start-file":
            self.title = ""
            self.codec = ""
            self.samplerate = 0
            self.publish()
        elif ev == "hertz-disconnected":
            self.idle = True
            self.loaded = False
            if self.mode == "playing":
                self.mode = "off"
            self.publish()

    def report_click(self):
        s = self.station
        if s and self.clicked != s["uuid"]:
            self.clicked = s["uuid"]
            self.jobs.put(("click", s["uuid"]))

    # ---- playback

    def find(self, uuid):
        for source in (self.results, self.favorites, self.queue):
            for s in source:
                if s.get("uuid") == uuid:
                    return s, source
        return None, None

    def play_station(self, station, source=None):
        if not public_stream(station.get("url", "")):
            # Directory data is untrusted: never point the player at a local
            # or private-network address.
            self.station = station
            self.mode = "off"
            self.error = "Station address is not on the public internet"
            self.publish()
            return
        if not self.mpv.start(self.volume):
            return
        self.station = station
        if source is None and not any(q["uuid"] == station["uuid"] for q in self.queue):
            _, source = self.find(station["uuid"])
        if source is not None:
            self.queue = list(source)[:200]
        self.title = ""
        self.error = ""
        self.mode = "playing"
        self.cancel_timer()
        self.clicked = None
        self.mpv.command("set_property", "pause", False)
        self.mpv.command("loadfile", station["url"], "replace", -1,
                         {"force-media-title": station["name"]})
        self.save()
        self.save_session()
        self.art.request([station])
        self.publish()

    def toggle(self):
        if not self.station:
            if self.results:
                self.play_station(self.results[0], self.results)
            return
        if self.mode == "playing":
            self.pause()
        else:
            self.play_station(self.station)   # always rejoin the live broadcast

    def pause(self):
        """Drop the stream but keep the station: no audio, no network."""
        if self.mode != "playing" and not (self.mode == "paused" and self.loaded):
            return
        self.mode = "paused"
        self.title = ""
        self.mpv.command("stop")
        self.schedule(IDLE_QUIT_AFTER, self.quit_if_paused)
        self.save_session()
        self.publish()

    def disconnect_if_paused(self):
        if self.mode == "paused" and self.loaded:
            self.pause()

    def quit_if_paused(self):
        if self.mode == "paused":
            self.mpv.quit()

    def schedule(self, delay, fn):
        self.cancel_timer()
        self.pause_timer = threading.Timer(delay, fn)
        self.pause_timer.daemon = True
        self.pause_timer.start()

    def cancel_timer(self):
        if self.pause_timer:
            self.pause_timer.cancel()
            self.pause_timer = None

    def step(self, delta):
        if not self.queue:
            return
        index = next((i for i, s in enumerate(self.queue) if self.station and s["uuid"] == self.station["uuid"]), -1)
        index = (index + delta) % len(self.queue)
        self.play_station(self.queue[index])

    def stop(self):
        """Turn the radio off: shut the player down; the station stays selected."""
        self.mode = "off"
        self.cancel_timer()
        self.error = ""
        self.title = ""
        self.mpv.quit()
        self.save_session()
        self.publish()

    def set_volume(self, value):
        self.volume = max(0, min(100, int(value)))
        if self.mpv.alive:
            self.mpv.command("set_property", "volume", self.volume)
        self.save()
        self.publish()

    def toggle_mute(self):
        self.muted = not self.muted
        if self.mpv.alive:
            self.mpv.command("set_property", "mute", self.muted)
        self.publish()

    def toggle_favorite(self, uuid):
        existing = [f for f in self.favorites if f["uuid"] == uuid]
        if existing:
            self.favorites = [f for f in self.favorites if f["uuid"] != uuid]
        else:
            station, _ = self.find(uuid)
            if not station:
                return
            self.favorites.insert(0, station)
        self.save()
        self.publish_favorites()
        self.publish()

    # ---- directory (worker thread)

    def request_search(self, spec):
        with self.gen_lock:
            self.generation += 1
            gen = self.generation
        self.jobs.put(("search", gen, spec))

    def worker(self):
        while True:
            job = self.jobs.get()
            try:
                if job[0] == "search":
                    self.run_search(*job[1:])
                elif job[0] == "countries":
                    self.run_countries()
                elif job[0] == "click":
                    self.directory.click(job[1])
            except Exception as e:  # keep the worker alive whatever happens
                log("worker:", repr(e))

    def run_search(self, gen, spec):
        genre = str(spec.get("genre") or "All")
        text = " ".join(str(spec.get("text") or "").split())[:80]
        page = max(0, min(int(spec.get("page") or 0), MAX_PAGE))
        country = spec.get("country") if valid_country(spec.get("country")) else ""
        key = f"{genre}|{country}|{text.lower()}"
        if page == 0 and (genre, country) != (self.last_genre, self.last_country):
            self.last_genre, self.last_country = genre, country
            self.save()
        if genre == "Favorites":
            items = [s for s in self.favorites
                     if (not text or text.lower() in s["name"].lower())
                     and (not country or s.get("countrycode") == country)]
            self.results = items
            emit({"type": "stations", "key": key, "page": 0, "items": items, "more": False, "genre": genre})
            self.art.request(items)
            return
        if page == 0:
            cached = self.list_cache.get(key)
            if cached:
                emit({"type": "stations", "key": key, "page": 0, "items": cached, "more": True,
                      "genre": genre, "cached": True})
        emit({"type": "loading", "key": key, "page": page})
        tags = self.genres.get(genre, [])
        try:
            items, more = self.directory.search(tags, text, page, country,
                                                genre if genre not in ("All", "Favorites") else "")
        except RuntimeError as e:
            if gen == self.generation:
                emit({"type": "stations-failed", "key": key, "page": page,
                      "message": "Radio directory unreachable" + (" — showing saved results" if self.list_cache.get(key) else "")})
            log("search failed:", e)
            return
        if gen != self.generation:
            return  # superseded by a newer query
        if page == 0:
            self.results = items
            self.list_cache[key] = items
            lists = [k for k in self.list_cache if not k.startswith("__")]
            if len(lists) > 40:
                self.list_cache.pop(lists[0])
            write_json(LIST_CACHE, self.list_cache)
        else:
            known = {s["uuid"] for s in self.results}
            self.results = self.results + [s for s in items if s["uuid"] not in known]
        emit({"type": "stations", "key": key, "page": page, "items": items, "more": more, "genre": genre})
        self.art.request(items)
        # A station resumed without its list (e.g. after a restart) adopts this one for next/prev.
        if self.station and not self.queue and any(i["uuid"] == self.station["uuid"] for i in self.results):
            self.queue = list(self.results)
            self.publish()

    # ---- command loop

    def handle(self, line):
        cmd, _, arg = line.strip().partition(" ")
        arg = arg.strip()
        if cmd == "search":
            try:
                spec = json.loads(arg) if arg else {}
            except ValueError:
                spec = {"text": arg}
            self.request_search(spec if isinstance(spec, dict) else {})
        elif cmd == "play":
            station, source = self.find(arg)
            if station:
                self.play_station(station, source)
        elif cmd == "toggle":
            self.toggle()
        elif cmd == "pause":
            self.pause()
        elif cmd in ("stop", "off"):
            self.stop()
        elif cmd == "next":
            self.step(1)
        elif cmd == "prev":
            self.step(-1)
        elif cmd == "retry":
            if self.station:
                self.play_station(self.station)
        elif cmd == "volume":
            try:
                self.set_volume(float(arg))
            except ValueError:
                pass
        elif cmd == "mute":
            self.toggle_mute()
        elif cmd == "fav":
            self.toggle_favorite(arg)
        elif cmd == "countries":
            self.jobs.put(("countries",))
        elif cmd == "favorites":
            self.publish_favorites()
        elif cmd == "hello":
            self.hello()

    def run_countries(self):
        cached = self.list_cache.get("__countries__")
        if cached:
            emit({"type": "countries", "items": cached, "cached": True})
        try:
            items = self.directory.countries()
        except RuntimeError as e:
            log("countries failed:", e)
            return
        if items:
            self.list_cache["__countries__"] = items
            write_json(LIST_CACHE, self.list_cache)
            emit({"type": "countries", "items": items})

    def hello(self):
        emit({"type": "genres", "items": [g for g in self.genres.keys()],
              "current": self.last_genre, "country": self.last_country})
        self.publish_favorites()
        self.publish()
        if self.station:
            self.art.request([self.station])

    def run(self):
        # Reattach to a stream a previous daemon (e.g. before a shell restart)
        # left playing. A paused session comes back paused, without a player.
        session = read_json(SESSION_FILE, {})
        mode = session.get("mode") or ("playing" if session.get("want") else "off")
        attached = self.mpv.attach()
        if isinstance(session.get("station"), dict) and mode in ("playing", "paused"):
            self.station = session["station"]
            self.queue = [s for s in session.get("queue", []) if isinstance(s, dict)]
            self.clicked = self.station.get("uuid")
            self.mode = "playing" if mode == "playing" and attached else "paused" if mode == "paused" else "off"
        if attached and self.mode != "playing":
            self.mpv.quit()
        self.hello()
        for line in sys.stdin:
            if line.strip():
                try:
                    self.handle(line)
                except Exception as e:
                    log("command failed:", line.strip(), repr(e))
        # Panel went away. Keep a playing stream alive for the next daemon;
        # an idle player has no reason to linger.
        if self.mode != "playing":
            self.mpv.quit()


def icy_title(meta):
    lowered = {str(k).lower(): v for k, v in meta.items()}
    title = lowered.get("icy-title") or ""
    if not title and lowered.get("title"):
        artist = lowered.get("artist")
        title = f"{artist} – {lowered['title']}" if artist else lowered["title"]
    title = " ".join(str(title).split())
    return "" if title in ("-", " - ") else title[:200]


def friendly_error(raw):
    raw = str(raw or "").lower()
    if "unrecognized" in raw or "format" in raw:
        return "Unsupported stream format"
    if "loading" in raw or "open" in raw:
        return "Station is not responding"
    if raw == "eof":
        return "Stream ended"
    return "Station unavailable"


# ------------------------------------------------------------------ cli


def cli(argv):
    os.umask(0o077)  # state, cache and sockets are private to this user
    if len(argv) < 2 or argv[1] == "daemon":
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
        Daemon().run()
        return 0
    cmd = argv[1]
    if cmd in ("search", "genre"):
        d = Directory()
        genres = read_json(os.path.join(HERE, "genres.json"), {})
        text = " ".join(argv[2:])
        tags, query = (genres.get(text, [text.lower()]), "") if cmd == "genre" else ([], text)
        items, more = d.search(tags, query, 0)
        for s in items:
            print(f"{s['uuid']}  {s['codec']:>5} {s['bitrate']:>4}k  {s['name']}  [{s['country']}]")
        print(f"-- {len(items)} stations{' (more)' if more else ''} via {d.mirrors[d.active]}", file=sys.stderr)
        return 0
    if cmd == "player":
        return run_player(int(argv[2]) if len(argv) > 2 and argv[2].isdigit() else 70)
    if cmd == "sandbox-net" and len(argv) > 4 and argv[3] == "--":
        return run_sandbox_net(argv[2], argv[4:])
    if cmd == "sandbox" and len(argv) > 4 and argv[3] == "--":
        return run_sandbox(argv[2], argv[4:])
    if cmd == "countries":
        for c in Directory().countries():
            print(f"{c['code']}  {c['count']:>6}  {c['name']}")
        return 0
    if cmd == "stop":
        m = Mpv(lambda _msg: None)
        if m.attach():
            m.quit()
        return 0
    if cmd in ("-v", "--version", "version"):
        print(VERSION)
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(cli(sys.argv))
