class Mpv:
    """Minimal mpv JSON-IPC client. Events go to `on_event`."""

    OBSERVED = ["pause", "core-idle", "paused-for-cache", "volume", "mute",
                "metadata", "path", "audio-codec-name", "audio-params/samplerate"]

    def __init__(self, on_event):
        self.on_event = on_event
        self.sock = None
        self.lock = threading.Lock()
        self.request_id = 0

    @property
    def alive(self):
        return self.sock is not None

    def attach(self):
        """Reuse an mpv left running by a previous daemon, if any."""
        if not os.path.exists(SOCKET):
            return False
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(SOCKET)
        except OSError:
            try:
                os.unlink(SOCKET)
            except OSError:
                pass
            return False
        self._adopt(s)
        return True

    def start(self, volume):
        if self.alive or self.attach():
            return True
        try:
            private_dir(RUNTIME)
        except OSError as e:
            emit({"type": "error", "message": f"Runtime folder is not private: {e}"})
            return False
        # Sandboxed player session: see run_player().
        cmd = [sys.executable, os.path.realpath(__file__), "player", str(volume)]
        try:
            with open(os.path.join(RUNTIME, "player.log"), "ab") as log_file:
                proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log_file,
                                        stderr=log_file, start_new_session=True)
            threading.Thread(target=proc.wait, daemon=True).start()  # reap on exit
        except OSError as e:
            emit({"type": "error", "message": f"Could not start mpv: {e}"})
            return False
        for _ in range(160):
            time.sleep(0.05)
            if self.attach():
                return True
            if proc.poll() is not None:
                break
        proc.kill()  # never leave an unreachable player behind
        emit({"type": "error", "message": "The sandboxed player could not start (needs mpv and bubblewrap)"})
        return False

    def _adopt(self, s):
        self.sock = s
        threading.Thread(target=self._reader, args=(s,), daemon=True).start()
        for i, name in enumerate(self.OBSERVED, 1):
            self.command("observe_property", i, name)

    def _reader(self, s):
        buf = b""
        try:
            while True:
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    try:
                        msg = json.loads(line)
                    except ValueError:
                        continue
                    self.on_event(msg)
        except OSError:
            pass
        with self.lock:
            if self.sock is s:
                self.sock = None
        self.on_event({"event": "hertz-disconnected"})

    def command(self, *args):
        with self.lock:
            if not self.sock:
                return False
            self.request_id += 1
            data = json.dumps({"command": list(args), "request_id": self.request_id}) + "\n"
            try:
                self.sock.sendall(data.encode())
                return True
            except OSError:
                return False

    def quit(self):
        self.command("quit")


