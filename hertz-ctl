class Directory:
    """Radio Browser client: mirror discovery, sticky failover, bounded reads."""

    def __init__(self):
        self.mirrors = []
        self.active = 0
        self.lock = threading.Lock()

    def discover(self):
        names = set()
        try:
            for info in socket.getaddrinfo("all.api.radio-browser.info", 443, proto=socket.IPPROTO_TCP):
                try:
                    host = socket.gethostbyaddr(info[4][0])[0]
                except OSError:
                    continue
                if host.endswith(".api.radio-browser.info"):
                    names.add("https://" + host)
        except OSError:
            pass
        self.mirrors = sorted(names) or list(FALLBACK_MIRRORS)
        self.active = random.randrange(len(self.mirrors))

    def get(self, path, params=None):
        with self.lock:
            if not self.mirrors:
                self.discover()
            mirrors, start = list(self.mirrors), self.active
        query = ("?" + urllib.parse.urlencode(params)) if params else ""
        last = "Radio directory unavailable"
        started = time.monotonic()
        for n in range(len(mirrors)):
            if time.monotonic() - started > API_TOTAL_DEADLINE:
                last = "Radio directory is not responding"
                break
            index = (start + n) % len(mirrors)
            req = urllib.request.Request(mirrors[index] + path + query, headers={"User-Agent": USER_AGENT})
            try:
                body = bounded_read(API_OPENER, req, MAX_BODY, API_DEADLINE)
                if len(body) > MAX_BODY:
                    raise ValueError("response too large")
                data = json.loads(body)
                with self.lock:
                    self.active = index
                return data
            except (OSError, ValueError, http.client.HTTPException) as e:
                last = str(getattr(e, "reason", e))
        with self.lock:
            self.mirrors = []  # rediscover next time
        raise RuntimeError(last)

    def search(self, tags, text, page, country="", genre=""):
        """One page of stations for a genre (list of tags), country and/or free text.

        Popular stations often carry dozens of tags, so a plain popularity sort
        puts a big news or pop station at the top of "Jazz". Stations whose own
        main genre is the selected one come first; popularity breaks ties."""
        def rank(s):
            return (bool(genre) and s["genre"] != genre, -s["clicks"])

        limit = min((page + 1) * PAGE, MERGE_CAP)
        requests = []
        for tag in tags or [""]:
            if text:
                requests.append({"name": text, "tagList": tag} if tag else {"name": text})
                if not tag:
                    requests.append({"tag": text})
            else:
                requests.append({"tagList": tag} if tag else {})
        base = {"hidebroken": "true", "order": "clickcount", "reverse": "true"}
        if country:
            base["countrycode"] = country

        if len(requests) == 1:
            # One query: page on the server, so scrolling never re-downloads
            # earlier pages. One extra row tells us whether more exist.
            params = dict(base, offset=str(page * PAGE), limit=str(PAGE + 1))
            params.update({k: v for k, v in requests[0].items() if v})
            rows = [s for s in map(slim, self.get("/json/stations/search", params)) if s]
            return sorted(rows[:PAGE], key=rank), len(rows) > PAGE

        # Several queries (multi-tag genres, name + tag search): merge them,
        # de-duplicate and rank by popularity, up to MERGE_CAP stations.
        stations, seen = [], set()
        for extra in requests:
            params = dict(base, limit=str(limit))
            params.update({k: v for k, v in extra.items() if v})
            for row in self.get("/json/stations/search", params):
                s = slim(row)
                if s and s["uuid"] not in seen:
                    seen.add(s["uuid"])
                    stations.append(s)
        stations.sort(key=rank)
        more = len(stations) > (page + 1) * PAGE or (len(stations) >= limit and limit < MERGE_CAP)
        return stations[page * PAGE:(page + 1) * PAGE], more

    def station(self, uuid):
        if not valid_uuid(uuid):
            return None
        rows = self.get(f"/json/stations/byuuid/{uuid}")
        return slim(rows[0]) if rows else None

    def countries(self):
        rows = self.get("/json/countries", {"hidebroken": "true"})
        out = []
        for c in rows if isinstance(rows, list) else []:
            code = str(c.get("iso_3166_1") or "")
            count = int(c.get("stationcount") or 0)
            if valid_country(code) and count > 0:
                out.append({"code": code, "name": country_name(c.get("name")), "count": count})
        out.sort(key=lambda c: c["name"].lower())
        return out

    def click(self, uuid):
        if valid_uuid(uuid):
            try:
                self.get(f"/json/url/{uuid}")
            except RuntimeError:
                pass


GENRES = read_json(os.path.join(HERE, "genres.json"), {})
GENRE_BY_TAG = {tag: name for name, tags in GENRES.items() for tag in tags}
NOISE_TAGS = {"aac", "aac+", "mp3", "ogg", "opus", "flac", "hls", "radio", "fm", "am", "music",
              "live", "internet", "internet radio", "webradio", "web radio", "free", "hd",
              "stereo", "online", "station", "entertainment", "hits", "local", "public radio"}


def genre_label(tags, country, places=()):
    """The most meaningful tag: a known genre first, else the first real word
    that is not a place or language (country, state, city) or format noise."""
    lowered = [t.lower() for t in tags]
    for t in lowered:
        if t in GENRE_BY_TAG:
            return GENRE_BY_TAG[t]
    skip = {country.lower()} | {p.lower() for p in places if p}
    for t in lowered:
        if (t not in NOISE_TAGS and t not in skip and len(t) > 2 and not t[:1].isdigit()
                and not t.endswith("kbps") and len(t) <= 24):
            return t[:1].upper() + t[1:]
    return ""


def sane_bitrate(value):
    try:
        kbps = int(value or 0)
    except (TypeError, ValueError):
        return 0
    if kbps > 4000:  # some stations report bits per second
        kbps //= 1000
    return kbps if 0 < kbps <= 4000 else 0


def slim(row):
    """Reduce a Radio Browser record to what the panel needs."""
    if not isinstance(row, dict) or row.get("lastcheckok") not in (1, None):
        return None
    uuid = str(row.get("stationuuid") or "")
    url = str(row.get("url_resolved") or row.get("url") or "")
    if not valid_uuid(uuid) or not http_url(url):
        return None
    tags = [t.strip() for t in str(row.get("tags") or "").split(",") if t.strip()]
    favicon = str(row.get("favicon") or "")
    return {
        "uuid": uuid,
        "name": " ".join(str(row.get("name") or "Unnamed station").split())[:120],
        "url": url,
        "favicon": favicon if http_url(favicon) else "",
        "homepage": str(row.get("homepage") or "")[:300],
        "tags": tags[:4],
        "genre": genre_label(tags, str(row.get("country") or ""),
                             [str(row.get("state") or "")] + str(row.get("language") or "").split(",")),
        "country": country_name(row.get("country"))[:60],
        "countrycode": str(row.get("countrycode") or "")[:2].upper(),
        "codec": str(row.get("codec") or "").upper()[:12],
        "bitrate": sane_bitrate(row.get("bitrate")),
        "hls": bool(row.get("hls")),
        "clicks": int(row.get("clickcount") or 0),
    }


