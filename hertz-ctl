LOGO_DEMUXERS = {".png": "png_pipe", ".jpg": "jpeg_pipe", ".gif": "gif_pipe",
                 ".webp": "webp_pipe", ".bmp": "bmp_pipe", ".ico": "ico"}


def transcode_logo(data):
    """Decode an untrusted logo inside the sandbox (no network at all) and
    return a small PNG rebuilt by rebuild_png(), or None. The shell only ever
    decodes that PNG."""
    ffmpeg = shutil.which("ffmpeg")
    demuxer = LOGO_DEMUXERS.get(Artwork.sniff(data) or "")
    if not ffmpeg or not demuxer or len(data) > MAX_ART:
        return None
    try:
        # One malloc arena keeps ffmpeg's per-thread reservations small enough
        # for a hard address-space limit.
        cmd, fds = sandbox_command(extra_env=[("MALLOC_ARENA_MAX", "1")])
    except OSError:
        return None
    cmd += ["--", "prlimit", "--nproc=32", "--", "ffmpeg", "-hide_banner", "-loglevel", "error",
            "-threads", "1", "-max_pixels", str(LOGO_MAX_PIXELS), "-f", demuxer, "-i", "pipe:0",
            "-frames:v", "1", "-map", "0:v:0", "-filter_threads", "1",
            "-vf", f"scale={LOGO_SIZE}:{LOGO_SIZE}:force_original_aspect_ratio=decrease:flags=area,format=rgba",
            "-threads", "1", "-c:v", "png", "-f", "image2pipe", "pipe:1"]

    def limits():
        import resource
        resource.setrlimit(resource.RLIMIT_AS, (LOGO_MEMORY, LOGO_MEMORY))
        resource.setrlimit(resource.RLIMIT_STACK, (2 << 20, 2 << 20))
        resource.setrlimit(resource.RLIMIT_CPU, (10, 10))
    try:
        out = subprocess.run(cmd, input=data, capture_output=True, timeout=LOGO_TIMEOUT,
                             pass_fds=fds, preexec_fn=limits)
    except (OSError, subprocess.TimeoutExpired):
        return None
    finally:
        for fd in fds:
            os.close(fd)
    if out.returncode != 0 or len(out.stdout) > 256 * 1024:
        return None
    return rebuild_png(out.stdout)


def _png_chunk(kind, body):
    return struct.pack(">I", len(body)) + kind + body + struct.pack(">I", zlib.crc32(kind + body) & 0xFFFFFFFF)


def rebuild_png(png):
    """Strictly parse ffmpeg's output (8-bit RGBA, not interlaced, at most
    LOGO_SIZE square, valid CRCs, pixel data of exactly the right size with
    valid filter bytes) and write a fresh, minimal PNG from the pixel data.
    Anything else is refused, so even a compromised decoder can only hand Qt
    a well-formed small image written by this function."""
    if not png.startswith(b"\x89PNG\r\n\x1a\n"):
        return None
    pos, header, idat = 8, None, []
    while True:
        if pos + 12 > len(png):
            return None
        length, kind = struct.unpack(">I4s", png[pos:pos + 8])
        body = png[pos + 8:pos + 8 + length]
        if len(body) != length or pos + 12 + length > len(png):
            return None
        crc = struct.unpack(">I", png[pos + 8 + length:pos + 12 + length])[0]
        if zlib.crc32(kind + body) & 0xFFFFFFFF != crc:
            return None
        pos += 12 + length
        if header is None:
            if kind != b"IHDR" or length != 13:
                return None
            header = struct.unpack(">IIBBBBB", body)
        elif kind == b"IDAT":
            idat.append(body)
        elif kind == b"IEND":
            break
        elif kind[:1].isupper():
            return None                    # unknown critical chunk (e.g. PLTE)
    width, height, depth, color, compression, filtering, interlace = header
    if not (0 < width <= LOGO_SIZE and 0 < height <= LOGO_SIZE) or (depth, color, compression,
                                                                     filtering, interlace) != (8, 6, 0, 0, 0):
        return None
    expected = (1 + width * 4) * height
    inflater = zlib.decompressobj()
    try:
        raw = inflater.decompress(b"".join(idat), expected + 1)
    except zlib.error:
        return None
    if len(raw) != expected or inflater.unconsumed_tail:
        return None
    if any(raw[row * (1 + width * 4)] > 4 for row in range(height)):
        return None
    return (b"\x89PNG\r\n\x1a\n" + _png_chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0))
            + _png_chunk(b"IDAT", zlib.compress(raw, 6)) + _png_chunk(b"IEND", b""))


LOGO_SIZE = 160
LOGO_MAX_PIXELS = 4096 * 4096
LOGO_MEMORY = 512 * 1024 * 1024
LOGO_TIMEOUT = 15


def private_dir(path):
    """Create (if needed) and return a directory only this user can use.
    Refuses symlinks and directories owned by someone else."""
    os.makedirs(path, mode=0o700, exist_ok=True)
    st = os.lstat(path)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        raise PermissionError(f"{path} is not a private directory")
    if stat.S_IMODE(st.st_mode) != 0o700:
        os.chmod(path, 0o700)
    return path


