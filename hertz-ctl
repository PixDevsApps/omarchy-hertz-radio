class Artwork:
    """Downloads station logos into the cache on a few worker threads."""

    TYPES = {"image/png": ".png", "image/jpeg": ".jpg", "image/jpg": ".jpg", "image/gif": ".gif",
             "image/webp": ".webp", "image/x-icon": ".ico",
             "image/vnd.microsoft.icon": ".ico", "image/bmp": ".bmp"}

    def __init__(self):
        self.jobs = queue.Queue()
        self.known = {}  # uuid -> path or "" (failed)
        self.lock = threading.Lock()
        os.makedirs(ART_DIR, exist_ok=True)
        threading.Thread(target=self.prune, daemon=True).start()
        for _ in range(4):
            threading.Thread(target=self.worker, daemon=True).start()

    ART_MAX_FILES = 3000
    ART_MAX_BYTES = 150 * 1024 * 1024

    def prune(self):
        """Keep the logo cache bounded: drop the least recently used files."""
        try:
            entries = []
            for e in os.scandir(ART_DIR):
                if e.name.endswith(".svg"):      # no longer displayed (see sniff)
                    os.unlink(e.path)
                    continue
                if e.is_file(follow_symlinks=False):
                    st = e.stat(follow_symlinks=False)
                    entries.append((st.st_atime, st.st_size, e.path))
        except OSError:
            return
        entries.sort()
        count, total = len(entries), sum(e[1] for e in entries)
        for _atime, size, path in entries:
            if count <= self.ART_MAX_FILES * 3 // 4 and total <= self.ART_MAX_BYTES * 3 // 4:
                break
            if count <= self.ART_MAX_FILES and total <= self.ART_MAX_BYTES and count == len(entries):
                break
            try:
                os.unlink(path)
                count, total = count - 1, total - size
            except OSError:
                pass

    def request(self, stations):
        for s in stations:
            uuid, url = s.get("uuid"), s.get("favicon")
            if not uuid or not url:
                continue
            with self.lock:
                path = self.known.get(uuid)
                if path is not None:
                    if path:
                        emit({"type": "art", "uuid": uuid, "path": path})
                    continue
                self.known[uuid] = ""
            self.jobs.put((uuid, url))

    def worker(self):
        while True:
            uuid, url = self.jobs.get()
            try:
                path = self.fetch(uuid, url)
            except Exception as e:  # keep the worker alive whatever a URL does
                log("artwork:", repr(e))
                path = None
            with self.lock:
                self.known[uuid] = path or ""
            if path:
                emit({"type": "art", "uuid": uuid, "path": path})

    def fetch(self, uuid, url):
        key = hashlib.sha1(url.encode()).hexdigest()[:16]
        for ext in set(self.TYPES.values()):
            p = os.path.join(ART_DIR, f"{uuid}-{key}{ext}")
            if os.path.exists(p):
                return p
        try:
            req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
            body = bounded_read(ART_OPENER, req, MAX_ART, ART_DEADLINE)
        except (OSError, ValueError, http.client.HTTPException):
            return None
        ext = self.sniff(body)   # trust the bytes, not the server's Content-Type
        if not ext or len(body) > MAX_ART or len(body) < 16:
            return None
        path = os.path.join(ART_DIR, f"{uuid}-{key}{ext}")
        tmp = path + ".tmp"
        with open(tmp, "wb") as f:
            f.write(body)
        os.replace(tmp, path)
        return path

    @staticmethod
    def sniff(body):
        if body.startswith(b"\x89PNG"):
            return ".png"
        if body.startswith(b"\xff\xd8"):
            return ".jpg"
        if body[:6] in (b"GIF87a", b"GIF89a"):
            return ".gif"
        if body[:4] == b"RIFF" and body[8:12] == b"WEBP":
            return ".webp"
        if body[:4] == b"\x00\x00\x01\x00":
            return ".ico"
        if body[:2] == b"BM":
            return ".bmp"
        return None  # SVG and anything unrecognised is not shown


