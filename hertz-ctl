#
# Media keys and the omarchy.media widget talk MPRIS over D-Bus. The player
# itself has no D-Bus access (it runs in the sandbox), so the daemon publishes
# MPRIS here, outside it, and maps calls onto the same actions as the panel.
# Requires python-gobject (part of Omarchy); without it only media-key
# control is missing.

MPRIS_NAME = "org.mpris.MediaPlayer2.hertzradio"
MPRIS_PATH = "/org/mpris/MediaPlayer2"
MPRIS_XML = """<node>
 <interface name="org.mpris.MediaPlayer2">
  <method name="Raise"/><method name="Quit"/>
  <property name="CanQuit" type="b" access="read"/>
  <property name="CanRaise" type="b" access="read"/>
  <property name="HasTrackList" type="b" access="read"/>
  <property name="Identity" type="s" access="read"/>
  <property name="SupportedUriSchemes" type="as" access="read"/>
  <property name="SupportedMimeTypes" type="as" access="read"/>
 </interface>
 <interface name="org.mpris.MediaPlayer2.Player">
  <method name="Next"/><method name="Previous"/><method name="Pause"/>
  <method name="PlayPause"/><method name="Stop"/><method name="Play"/>
  <method name="Seek"><arg name="Offset" type="x" direction="in"/></method>
  <method name="SetPosition"><arg name="TrackId" type="o" direction="in"/><arg name="Position" type="x" direction="in"/></method>
  <method name="OpenUri"><arg name="Uri" type="s" direction="in"/></method>
  <signal name="Seeked"><arg name="Position" type="x"/></signal>
  <property name="PlaybackStatus" type="s" access="read"/>
  <property name="Rate" type="d" access="readwrite"/>
  <property name="Metadata" type="a{sv}" access="read"/>
  <property name="Volume" type="d" access="readwrite"/>
  <property name="Position" type="x" access="read"/>
  <property name="MinimumRate" type="d" access="read"/>
  <property name="MaximumRate" type="d" access="read"/>
  <property name="CanGoNext" type="b" access="read"/>
  <property name="CanGoPrevious" type="b" access="read"/>
  <property name="CanPlay" type="b" access="read"/>
  <property name="CanPause" type="b" access="read"/>
  <property name="CanSeek" type="b" access="read"/>
  <property name="CanControl" type="b" access="read"/>
 </interface>
</node>"""


def split_title(title):
    """'Artist - Song' -> (artist, song); otherwise ('', title)."""
    parts = re.split(r"\s+[-–—]\s+", title or "", maxsplit=1)
    return (parts[0].strip(), parts[1].strip()) if len(parts) == 2 and parts[0].strip() and parts[1].strip() else ("", (title or "").strip())


class Mpris:
    def __init__(self, daemon):
        self.daemon = daemon
        self.snapshot = {}
        self.connection = None
        try:
            import gi
            gi.require_version("Gio", "2.0")
            from gi.repository import Gio, GLib
        except (ImportError, ValueError) as e:
            log("mpris: python-gobject unavailable, media keys disabled:", e)
            self.GLib = None
            return
        self.Gio, self.GLib = Gio, GLib
        self.node = Gio.DBusNodeInfo.new_for_xml(MPRIS_XML)
        self.loop = GLib.MainLoop()
        threading.Thread(target=self._run, daemon=True).start()

    def _run(self):
        self.Gio.bus_own_name(self.Gio.BusType.SESSION, MPRIS_NAME, self.Gio.BusNameOwnerFlags.NONE,
                              self._on_bus, None, None)
        self.loop.run()

    def _on_bus(self, connection, _name):
        self.connection = connection
        register = getattr(connection, "register_object_with_closures2", None) or connection.register_object
        for iface in self.node.interfaces:
            register(MPRIS_PATH, iface, self._call, self._get, self._set)

    # -- D-Bus handlers (GLib thread)

    def _call(self, _conn, _sender, _path, iface, method, _params, invocation):
        actions = {"Next": "next", "Previous": "prev", "Pause": "pause", "PlayPause": "toggle",
                   "Stop": "stop", "Play": "play-resume"}
        if method in actions:
            self.daemon.handle(actions[method])
        elif method == "OpenUri":
            invocation.return_dbus_error("org.mpris.MediaPlayer2.Error.NotSupported",
                                         "Hertz Radio only plays stations from its directory")
            return
        invocation.return_value(None)

    def _get(self, _conn, _sender, _path, iface, prop):
        return self._properties(iface).get(prop)

    def _set(self, _conn, _sender, _path, iface, prop, value):
        if prop == "Volume":
            self.daemon.handle(f"volume {max(0.0, min(1.0, value.unpack())) * 100:.0f}")
        return True

    # -- state

    def _properties(self, iface):
        V = self.GLib.Variant
        snap = self.snapshot
        if iface == "org.mpris.MediaPlayer2":
            return {"CanQuit": V("b", False), "CanRaise": V("b", False), "HasTrackList": V("b", False),
                    "Identity": V("s", "Hertz Radio"), "SupportedUriSchemes": V("as", []),
                    "SupportedMimeTypes": V("as", [])}
        station = snap.get("station")
        status = "Playing" if snap.get("playing") else "Paused" if snap.get("paused") else "Stopped"
        metadata = {}
        if station and status != "Stopped":
            artist, song = split_title(snap.get("title", ""))
            metadata = {
                "mpris:trackid": V("o", "/io/github/pixdevsapps/HertzRadio/station/"
                                   + station["uuid"].replace("-", "_")),
                "xesam:title": V("s", song or station["name"]),
                "xesam:album": V("s", station["name"]),
            }
            if artist:
                metadata["xesam:artist"] = V("as", [artist])
            if snap.get("art"):
                metadata["mpris:artUrl"] = V("s", "file://" + urllib.parse.quote(snap["art"]))
        return {"PlaybackStatus": V("s", status), "Rate": V("d", 1.0), "Metadata": V("a{sv}", metadata),
                "Volume": V("d", snap.get("volume", 0) / 100.0), "Position": V("x", 0),
                "MinimumRate": V("d", 1.0), "MaximumRate": V("d", 1.0),
                "CanGoNext": V("b", bool(snap.get("hasNext"))), "CanGoPrevious": V("b", bool(snap.get("hasNext"))),
                "CanPlay": V("b", bool(station)), "CanPause": V("b", bool(snap.get("playing"))),
                "CanSeek": V("b", False), "CanControl": V("b", True)}

    def update(self, snapshot):
        if self.GLib is None:
            return
        self.GLib.idle_add(self._emit, snapshot)

    def _emit(self, snapshot):
        before = self._properties("org.mpris.MediaPlayer2.Player") if self.snapshot else {}
        self.snapshot = snapshot
        after = self._properties("org.mpris.MediaPlayer2.Player")
        changed = {k: v for k, v in after.items() if k not in before or before[k] != v}
        if changed and self.connection is not None:
            self.connection.emit_signal(None, MPRIS_PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                                        self.GLib.Variant("(sa{sv}as)", ("org.mpris.MediaPlayer2.Player", changed, [])))
        return False


