class Mpv:
    """Minimal mpv JSON-IPC client. Events go to `on_event`."""

    OBSERVED = ["pause", "core-idle", "paused-for-cache", "volume", "mute",
                "metadata", "path", "audio-codec-name", "audio-params/samplerate"]

    def __init__(self, on_event):
        self.on_event = on_event
        self.sock = None
        self.lock = threading.Lock()
        self.request_id = 0

    @property
    def alive(self):
        return self.sock is not None

    def attach(self):
        """Reuse an mpv left running by a previous daemon, if any."""
        try:
            if not stat.S_ISSOCK(os.lstat(SOCKET).st_mode):
                return False
        except OSError:
            return False
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(SOCKET)
        except OSError:
            try:
                os.unlink(SOCKET)
            except OSError:
                pass
            return False
        self._adopt(s)
        return True

    def start(self, volume):
        if self.alive or self.attach():
            return True
        try:
            private_dir(RUNTIME)
        except OSError as e:
            emit({"type": "error", "message": f"Runtime folder is not private: {e}"})
            return False
        # Sandboxed player session (see run_player); its resource limits are
        # applied inside the sandbox (see run_sandbox).
        cmd = [sys.executable, os.path.realpath(__file__), "player", str(volume)]
        try:
            log_fd = os.open(os.path.join(RUNTIME, "session.log"),
                             os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
            try:
                proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log_fd,
                                        stderr=log_fd, start_new_session=True)
            finally:
                os.close(log_fd)
            threading.Thread(target=proc.wait, daemon=True).start()  # reap on exit
            write_json(PID_FILE, {"pid": proc.pid, "start": process_start(proc.pid)})
        except OSError as e:
            emit({"type": "error", "message": f"Could not start mpv: {e}"})
            return False
        for _ in range(160):
            time.sleep(0.05)
            if self.attach():
                return True
            if proc.poll() is not None:
                break
        self.kill_player()  # never leave an unreachable player behind
        emit({"type": "error", "message": "The sandboxed player could not start (needs mpv, bubblewrap and pw-cat)"})
        return False

    def _adopt(self, s):
        self.sock = s
        threading.Thread(target=self._reader, args=(s,), daemon=True).start()
        for i, name in enumerate(self.OBSERVED, 1):
            self.command("unobserve_property", i)    # a previous daemon's observers
            self.command("observe_property", i, name)

    def _reader(self, s):
        buf = bytearray()
        try:
            while True:
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
                while True:
                    end = buf.find(b"\n")
                    if end < 0:
                        if len(buf) > MAX_IPC_LINE:
                            buf.clear()        # overlong line: drop it
                        break
                    line = bytes(buf[:end])
                    del buf[:end + 1]
                    if len(line) > MAX_IPC_LINE:
                        continue
                    try:
                        msg = json.loads(line)
                    except (ValueError, RecursionError):
                        continue
                    if isinstance(msg, dict):
                        try:
                            self.on_event(msg)
                        except Exception as e:   # a malformed message must not stop the reader
                            log("mpv event ignored:", type(e).__name__)
        except OSError:
            pass
        with self.lock:
            if self.sock is s:
                self.sock = None
        self.on_event({"event": "hertz-disconnected"})

    def command(self, *args):
        with self.lock:
            if not self.sock:
                return False
            self.request_id += 1
            data = json.dumps({"command": list(args), "request_id": self.request_id}) + "\n"
            try:
                self.sock.sendall(data.encode())
                return True
            except OSError:
                return False

    def quit(self):
        self.command("quit")

    def terminate(self, wait=False):
        """Ask mpv to quit, and make sure the whole player session is gone a
        few seconds later even if the sandboxed player ignores the request."""
        self.quit()
        if wait:
            self.kill_player(grace=PLAYER_QUIT_GRACE)
        else:
            threading.Thread(target=self.kill_player, kwargs={"grace": PLAYER_QUIT_GRACE},
                             daemon=True).start()

    @staticmethod
    def kill_player(grace=0.0):
        info = read_json(PID_FILE, {})
        pid, start = info.get("pid"), info.get("start")
        if not isinstance(pid, int) or pid <= 1 or not start:
            return
        alive = lambda: process_start(pid) == start          # not a recycled pid
        deadline = time.monotonic() + grace
        while alive() and time.monotonic() < deadline:
            time.sleep(0.1)
        for sig, pause in ((signal.SIGTERM, 2.0), (signal.SIGKILL, 1.0)):
            if not alive():
                break
            try:
                os.killpg(pid, sig)       # the session's own process group
            except OSError:
                break
            end = time.monotonic() + pause
            while alive() and time.monotonic() < end:
                time.sleep(0.1)
        if not alive():
            try:
                os.unlink(PID_FILE)
            except OSError:
                pass


