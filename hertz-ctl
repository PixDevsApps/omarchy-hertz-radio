def _capped_log(stream, path):
    """Copy a child's stderr to `path`, keeping only the first 256 KiB."""
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    except OSError:
        fd = None
    written = 0
    for chunk in iter(lambda: stream.read(8192), b""):
        if fd is not None and written < PLAYER_LOG_LIMIT:
            part = chunk[:PLAYER_LOG_LIMIT - written]
            os.write(fd, part)
            written += len(part)
    if fd is not None:
        os.close(fd)


class _IpcRelay:
    """Relays mpv's control connection (an inherited socket inside the
    sandbox) to SOCKET, a Unix socket in the private runtime folder that the
    sandbox can't see or touch. Several local clients may be connected (the
    daemon, `hertz-ctl stop`); mpv's messages go to all of them."""

    MAX_CLIENTS = 8

    def __init__(self, mpv_end, path):
        self.mpv = mpv_end
        self.clients = set()
        self.lock = threading.Lock()
        self.server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.server.bind(path)
        self.server.listen(4)
        threading.Thread(target=self._accept, daemon=True).start()
        threading.Thread(target=self._from_mpv, daemon=True).start()

    def _accept(self):
        while True:
            try:
                conn, _ = self.server.accept()
            except OSError:
                return
            with self.lock:
                if len(self.clients) >= self.MAX_CLIENTS:
                    conn.close()
                    continue
                self.clients.add(conn)
            threading.Thread(target=self._to_mpv, args=(conn,), daemon=True).start()

    def _drop(self, conn):
        with self.lock:
            self.clients.discard(conn)
        try:
            conn.close()
        except OSError:
            pass

    def _to_mpv(self, conn):
        try:
            for chunk in iter(lambda: conn.recv(65536), b""):
                with self.lock:
                    self.mpv.sendall(chunk)
        except OSError:
            pass
        self._drop(conn)

    def _from_mpv(self):
        try:
            for chunk in iter(lambda: self.mpv.recv(65536), b""):
                with self.lock:
                    clients = list(self.clients)
                for client in clients:
                    try:
                        client.sendall(chunk)
                    except OSError:
                        self._drop(client)
        except OSError:
            pass
        self.close()

    def close(self):
        with self.lock:
            clients, self.clients = list(self.clients), set()
        for s in (*clients, self.server):
            try:
                s.close()
            except OSError:
                pass


def process_start(pid):
    """A process's start time (to recognise it again), or None if it is gone
    or only a zombie waiting to be reaped."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            fields = f.read().rsplit(")", 1)[1].split()
        return None if fields[0] in ("Z", "X") else fields[19]
    except (OSError, IndexError):
        return None


def run_player(volume):
    """`hertz-ctl player`: guarded proxy + IPC relay + sandboxed mpv + pw-cat."""
    os.umask(0o077)
    # When the daemon ends the session with SIGTERM, still run the cleanup below.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    private_dir(RUNTIME)
    pw_cat = shutil.which("pw-cat")
    if not pw_cat:
        log("player: pw-cat (pipewire) is required for audio output")
        return 3
    proxy_path = os.path.join(RUNTIME, "proxy.sock")
    for stale in (proxy_path, SOCKET):     # both live in the private runtime folder
        if os.path.lexists(stale):
            if not stat.S_ISSOCK(os.lstat(stale).st_mode):
                log(f"player: {stale} exists and is not a socket")
                return 3
            os.unlink(stale)
    proxy = GuardedProxy(proxy_path)
    threading.Thread(target=proxy.serve_forever, daemon=True).start()
    ours, theirs = socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM)
    relay = _IpcRelay(ours, SOCKET)
    try:
        cmd, fds = sandbox_command([("--ro-bind", proxy_path, SANDBOX_PROXY)],
                                   extra_env=[("MALLOC_ARENA_MAX", "2")], with_script=True)
    except OSError as e:
        log(f"player: {e}")
        return 3
    cmd += ["--", "python3", SANDBOX_SCRIPT, "sandbox", SANDBOX_PROXY, str(SANDBOX_IPC_FD),
            "--", *mpv_arguments(volume)]
    audio = None
    try:
        # mpv's control socket gets a fixed, out-of-the-way number, so it can't
        # collide with the other descriptors handed to bubblewrap.
        os.dup2(theirs.fileno(), SANDBOX_IPC_FD)
        theirs.close()
        sandbox = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                   stderr=subprocess.PIPE, pass_fds=[*fds, SANDBOX_IPC_FD])
        os.close(SANDBOX_IPC_FD)
        for fd in fds:
            os.close(fd)
        threading.Thread(target=_capped_log, args=(sandbox.stderr, os.path.join(RUNTIME, "player.log")),
                         daemon=True).start()
        audio = subprocess.Popen([pw_cat, "--playback", "--raw", "--rate", str(PCM_RATE),
                                  "--channels", "2", "--format", PCM_FORMAT, "--media-role", "Music",
                                  "-P", '{ application.name = "Hertz Radio" node.description = "Hertz Radio" }',
                                  "-"], stdin=sandbox.stdout, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
        sandbox.stdout.close()           # pw-cat owns the read end now
        return sandbox.wait()
    finally:
        relay.close()
        ours.close()
        if audio is not None:
            audio.terminate()
            try:
                audio.wait(timeout=3)
            except subprocess.TimeoutExpired:
                audio.kill()
        proxy.shutdown()
        proxy.server_close()
        for path in (proxy_path, SOCKET):
            try:
                os.unlink(path)
            except OSError:
                pass


def sandbox_is_sealed():
    """Refuse to run the player unless it has no capabilities and no route out."""
    with open("/proc/self/status") as f:
        caps = {k: v.strip() for k, v in (line.split(":", 1) for line in f if line.startswith("Cap"))}
    if any(int(caps.get(k, "0"), 16) for k in ("CapEff", "CapPrm", "CapAmb", "CapBnd")):
        return False
    if os.path.exists("/home"):
        return False
    for family, address in ((socket.AF_INET, ("1.1.1.1", 443)), (socket.AF_INET6, ("2606:4700:4700::1111", 443))):
        try:
            with socket.socket(family, socket.SOCK_STREAM) as s:
                s.settimeout(1)
                s.connect(address)
            return False
        except OSError as e:
            if e.errno not in (errno.ENETUNREACH, errno.EHOSTUNREACH, errno.EADDRNOTAVAIL, errno.EAFNOSUPPORT):
                return False
    try:                                   # the seccomp socket-family filter is active
        socket.socket(40, socket.SOCK_STREAM).close()     # AF_VSOCK
        return False
    except OSError as e:
        if e.errno != errno.EAFNOSUPPORT:
            return False
    return True


def run_sandbox(proxy_path, ipc_fd, mpv_cmd):
    """`hertz-ctl sandbox` (inside bubblewrap): check the seal, start the bridge, run mpv."""
    if not sandbox_is_sealed():
        print("hertz-ctl: sandbox isolation check failed; refusing to start the player", file=sys.stderr)
        return 4
    import resource
    # The sandbox has its own user namespace, so this counts only its own
    # processes and threads.
    resource.setrlimit(resource.RLIMIT_NPROC, (SANDBOX_TASKS, SANDBOX_TASKS))
    bridge = _Bridge(proxy_path)
    threading.Thread(target=bridge.serve_forever, daemon=True).start()
    proxy_url = f"http://127.0.0.1:{bridge.server_address[1]}"
    env = dict(os.environ, http_proxy=proxy_url, https_proxy=proxy_url,
               HTTP_PROXY=proxy_url, HTTPS_PROXY=proxy_url, no_proxy="", NO_PROXY="")

    def limits():
        resource.setrlimit(resource.RLIMIT_AS, (PLAYER_MEMORY, PLAYER_MEMORY))
    return subprocess.run([*mpv_cmd, f"--http-proxy={proxy_url}"], env=env, pass_fds=(ipc_fd,),
                          stdin=subprocess.DEVNULL, preexec_fn=limits).returncode


