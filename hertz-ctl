def country_name(raw):
    """Radio Browser's ISO names, made readable: 'The Netherlands' -> 'Netherlands'."""
    name = " ".join(str(raw or "").split())[:80]
    if name in COUNTRY_NAMES:
        return COUNTRY_NAMES[name]
